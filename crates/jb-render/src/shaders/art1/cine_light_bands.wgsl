// One band: b = (centre x, width, opacity, white core), x in frame widths.
fn band(col: vec3f, x: f32, y: f32, b: vec4f) -> vec3f {
    if (b.z <= 0.0) { return col; }
    // the band edges waver a little along the height
    let d = abs(x - b.x + 0.004 * sin(y * 7.0 + b.x * 20.0)) / max(b.y, 1e-3);
    let t1 = select(1.0, clamp((d - b.w) / 0.15 + 0.5, 0.0, 1.0), b.w > 0.01);
    let t2 = clamp((d - (0.5 + 0.5 * b.w)) / 0.15 + 0.5, 0.0, 1.0);
    let c = mix(vec3f(1.0, 1.0, 0.95), mix(vec3f(1.0, 0.92, 0.2), vec3f(1.0, 0.45, 0.05), t2), t1);
    let al = clamp((1.15 - d) / 0.3, 0.0, 1.0) * b.z;
    return mix(col, c, al);
}

fn fx(uv: vec2f) -> vec4f {
    var col = a1_da(uv);
    col = band(col, uv.x, uv.y, u.p[1]);
    col = band(col, uv.x, uv.y, u.p[2]);
    return a1_out_a(col, a1_alpha(uv));
}
