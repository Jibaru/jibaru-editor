{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jibaru Editor",
  "version": "0.1.2",
  "identifier": "dev.jibaru.editor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Jibaru Editor",
        "width": 1512,
        "height": 944,
        "minWidth": 1100,
        "minHeight": 680,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#000000",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Video",
    "shortDescription": "Open-source video editor",
    "copyright": "Apache-2.0"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA1RTUzQzhBRUNEQzc2MzAKUldRd2R0enNpanpsQmUwSVZGU0Nqa0htaVI3cHBYOXN5NWI1UzBVN0RsUmt0SUcrNktOR3BhcXEK",
      "endpoints": ["https://github.com/Jibaru/jibaru-editor/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
