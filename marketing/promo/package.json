{
  "name": "jibaru-editor-promo",
  "version": "1.0.0",
  "private": true,
  "description": "Social media promo video for Jibaru Editor, built with Remotion.",
  "scripts": {
    "dev": "remotion studio",
    "clips": "bash scripts/generate-clips.sh",
    "render:vertical": "remotion render PromoVertical out/jibaru-promo-vertical.mp4 --codec=h264 --crf=16",
    "render:landscape": "remotion render PromoLandscape out/jibaru-promo-landscape.mp4 --codec=h264 --crf=16",
    "render:cover": "remotion still Cover out/jibaru-cover.png",
    "render:teaser": "remotion render Teaser out/jibaru-teaser.gif --codec=gif --every-nth-frame=2",
    "render": "npm run render:vertical && npm run render:landscape && npm run render:cover && npm run render:teaser",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.536",
    "@remotion/google-fonts": "4.0.536",
    "@remotion/media": "4.0.536",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@remotion/bundler": "^4.0.536",
    "@remotion/renderer": "^4.0.536",
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}
